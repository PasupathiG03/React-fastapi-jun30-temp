PROJECT_NAME=Bigbasket-Image Cropping Tool
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ui
SECRET_KEY=generate-with-python-secrets-token-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480   # longest a single sign-in can last
SESSION_IDLE_MINUTES=30          # signed out after this long without activity

# Set to False in production: it turns off /docs and makes the session cookie Secure (HTTPS only).
DEBUG=False

# Browser origins allowed to call this API, comma separated. Never use *.
CORS_ORIGINS=http://localhost:8106
# COOKIE_SECURE=true
# COOKIE_SAMESITE=strict

# Initial password for newly created users
DEFAULT_PASSWORD=change-me

# Photoroom AI Background Removal API (https://docs.photoroom.com/)
PHOTOROOM_API_KEY=your-photoroom-api-key-here
BG_REMOVAL_PROVIDER=photoroom


# Google Gemini Classification API (https://ai.google.dev/gemini-api/docs/models)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_ATTEMPTS=3

# Redis & Celery Distributed Task Queue configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
