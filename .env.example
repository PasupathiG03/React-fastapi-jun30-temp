# Copy to .env and fill in. Lines marked "required" stop the backend from starting if missing.

# ── App (required) ────────────────────────────────────────────────────────────
PROJECT_NAME=Bigbasket-Image Cropping Tool
# Your existing PostgreSQL. Use @localhost: Docker automatically maps it to the host machine
# (host.docker.internal), so the same line works with and without Docker. URL-encode special
# characters in the password (@ becomes %40).
DATABASE_URL=postgresql+psycopg2://db_user:db_password@localhost:5432/db_name
SECRET_KEY=generate-with-python-secrets-token-hex-32
ALGORITHM=HS256

# Longest a single sign-in can last (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Signed out after this many minutes without activity (optional, default 30)
SESSION_IDLE_MINUTES=30

# Set to False in production: it turns off /docs and makes the session cookie Secure (HTTPS only).
DEBUG=False

# Ports (the only place to change them: Docker, the frontend and the backend all read these).
FRONTEND_PORT=8106
BACKEND_PORT=8107
# Optional: full API address if the API is hosted somewhere else (default: same host as the page, BACKEND_PORT).
# API_URL=

# Browser origins allowed to call this API, comma separated. Never use *.
# Private-network addresses (192.168.x.x, 10.x.x.x, 172.16-31.x.x) on FRONTEND_PORT are allowed automatically.
# Set CORS_ALLOW_PRIVATE_NETWORK=false to turn that off, then list every address here. Public addresses must be listed.
# Keep the ports below in step with FRONTEND_PORT.
CORS_ORIGINS=http://localhost:8106,http://127.0.0.1:8106
# COOKIE_SECURE=true
# COOKIE_SAMESITE=strict

# Initial password for newly created users (required).
# Must be 10+ characters with an upper-case letter, a lower-case letter, a digit and a symbol.
DEFAULT_PASSWORD=Change-Me-123!

# ── Photoroom AI Background Removal (https://docs.photoroom.com/) ─────────────
PHOTOROOM_API_KEY=your-photoroom-api-key-here
# Optional: credits shown on the API dashboard (default 1000)
# PHOTOROOM_MONTHLY_QUOTA=1000

# ── Google Gemini Classification (https://ai.google.dev/gemini-api/docs/models) ─
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: second model used only when GEMINI_MODEL stays overloaded (429/503) after all retries.
# Use a different model than GEMINI_MODEL — capacity is per model. See https://aistudio.google.com/docs/models
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Required: retries per Gemini call (per model)
GEMINI_MAX_ATTEMPTS=4
# Optional: faster classification (off when empty). Test accuracy on your images first.
# GEMINI_THINKING_LEVEL=low

# ── Redis & Celery (required) ─────────────────────────────────────────────────
# In Docker, localhost/127.0.0.1 here is mapped to the redis container automatically.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_CONCURRENCY=4

# ── Local Background Removal (BiRefNet via Hugging Face) ──────────────────────
HF_TOKEN=
# Local background-removal model (BiRefNet) downloads here on first use. Docker mounts ./models for it.
MODEL_CACHE=models
